{
  "name": "sigmashake-tokens",
  "version": "0.1.0",
  "description": "Local token-spend monitor for Claude Code, Codex, and Grok sessions. One binary: service, dashboard, CLI, MCP server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigmashakeinc/tokens.git"
  },
  "homepage": "https://github.com/sigmashakeinc/tokens#readme",
  "bugs": {
    "url": "https://github.com/sigmashakeinc/tokens/issues"
  },
  "bin": {
    "tokens": "src/main.ts",
    "sigmashake-tokens": "tools/sigmashake-tokens-cli.ts"
  },
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "scan": "bun src/cli.ts scan",
    "report": "bun src/cli.ts report",
    "govern": "bun src/cli.ts govern",
    "tokens:dev": "bun --hot src/server.ts",
    "tokens:start": "bun src/server.ts",
    "tokens:scan": "bun src/cli.ts scan",
    "tokens:report": "bun src/cli.ts report",
    "tokens:govern": "bun src/cli.ts govern",
    "test": "bun test test/",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "bunx tsc --noEmit",
    "test:integration": "bun test test/integration",
    "test:regression": "bun test test/regression",
    "test:api": "bun test test/api",
    "test:configuration": "bun test test/configuration",
    "test:sast": "bun test test/sast",
    "test:audit": "bun test test/dependencies",
    "test:component": "bun test test/component/",
    "test:e2e": "bun test test/e2e/",
    "test:load": "bun test test/load/",
    "test:stress": "bun test test/stress/",
    "test:spike": "bun test test/spike/",
    "test:soak": "bun test test/soak/",
    "test:scale": "bun test test/scalability/",
    "test:chaos": "bun test test/chaos/",
    "test:failover": "bun test test/failover/",
    "test:dr": "bun test test/dr/",
    "test:dast": "bun test test/dast/",
    "test:pen": "bun test test/pen/",
    "serve": "bun src/main.ts serve",
    "build": "bun build --compile src/main.ts --outfile dist/tokens"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/bun": "^1.3.12",
    "typescript": "latest"
  }
}
